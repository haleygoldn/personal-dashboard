# .env.example
# Copy this file to .env.local and fill in your values
# NEVER commit .env or .env.local to version control

# Hermes AI Configuration
HERMES_API_KEY=
HERMES_MODEL=claude-3-5-sonnet

# GitHub
GITHUB_TOKEN=
GITHUB_USERNAME=

# Financial Data (use read-only exports)
FIDELITY_EXPORT_PATH=./data/private/fidelity.json
BANK_EXPORT_PATH=./data/private/bank.json

# Fitness Data
APPLE_HEALTH_EXPORT_PATH=./data/private/apple-health.json
STRAVA_API_KEY=

# Application
NEXT_PUBLIC_APP_NAME=Personal Dashboard
NODE_ENV=development
